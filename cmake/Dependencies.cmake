include(FetchContent)

if(IMFORGE_IMGUI_DIR)
    set(FETCHCONTENT_SOURCE_DIR_IMGUI "${IMFORGE_IMGUI_DIR}")
endif()
FetchContent_Declare(imgui
    GIT_REPOSITORY https://github.com/ocornut/imgui.git
    GIT_TAG        ${IMFORGE_IMGUI_TAG}
    GIT_SHALLOW    TRUE
    GIT_PROGRESS   TRUE
    SOURCE_SUBDIR  imforge_no_cmake_project)
FetchContent_MakeAvailable(imgui)

if(NOT EXISTS "${imgui_SOURCE_DIR}/imgui.h")
    message(FATAL_ERROR "Dear ImGui sources not found at ${imgui_SOURCE_DIR}")
endif()

file(STRINGS "${imgui_SOURCE_DIR}/imgui.h" _imforge_imgui_ver_line REGEX "^#define[ \t]+IMGUI_VERSION_NUM[ \t]+[0-9]+")
string(REGEX MATCH "[0-9]+" IMFORGE_IMGUI_VERSION_NUM "${_imforge_imgui_ver_line}")
file(STRINGS "${imgui_SOURCE_DIR}/imgui.h" _imforge_imgui_dock_line REGEX "^#define[ \t]+IMGUI_HAS_DOCK")
if(_imforge_imgui_dock_line)
    set(IMFORGE_IMGUI_HAS_DOCK ON)
else()
    set(IMFORGE_IMGUI_HAS_DOCK OFF)
endif()
message(STATUS "ImForge: Dear ImGui '${IMFORGE_IMGUI_TAG}' IMGUI_VERSION_NUM=${IMFORGE_IMGUI_VERSION_NUM} docking=${IMFORGE_IMGUI_HAS_DOCK} (${imgui_SOURCE_DIR})")

file(GLOB IMFORGE_IMGUI_SOURCES CONFIGURE_DEPENDS "${imgui_SOURCE_DIR}/imgui*.cpp")
add_library(imgui STATIC ${IMFORGE_IMGUI_SOURCES} "${imgui_SOURCE_DIR}/misc/cpp/imgui_stdlib.cpp")
add_library(imgui::imgui ALIAS imgui)
target_include_directories(imgui PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/misc/cpp")
target_compile_features(imgui PUBLIC cxx_std_11)
set_target_properties(imgui PROPERTIES FOLDER "third_party")

function(imforge_add_imgui_backend name)
    set(_src "${imgui_SOURCE_DIR}/backends/imgui_impl_${name}.cpp")
    if(NOT EXISTS "${_src}")
        message(STATUS "ImForge: Dear ImGui backend '${name}' does not exist in this version, skipping imgui_impl_${name}")
        return()
    endif()
    add_library(imgui_impl_${name} STATIC "${_src}")
    target_include_directories(imgui_impl_${name} PUBLIC "${imgui_SOURCE_DIR}/backends")
    target_link_libraries(imgui_impl_${name} PUBLIC imgui ${ARGN})
    set_target_properties(imgui_impl_${name} PROPERTIES FOLDER "third_party")
endfunction()

set(_need_sdl3 OFF)
set(_need_gl3 OFF)
set(_need_win32 OFF)
set(_need_dx9 OFF)
set(_need_dx11 OFF)
set(_need_dx12 OFF)
set(_need_vulkan OFF)
if(IMFORGE_BUILD_BUILDER)
    if(IMFORGE_BUILDER_BACKEND STREQUAL "SDL3_GL3")
        set(_need_sdl3 ON)
        set(_need_gl3 ON)
    else()
        set(_need_win32 ON)
        set(_need_dx11 ON)
    endif()
endif()
if(IMFORGE_BUILD_EXAMPLES)
    set(_need_sdl3 ON)
    set(_need_gl3 ON)
    if(WIN32)
        set(_need_win32 ON)
        set(_need_dx9 ON)
        set(_need_dx11 ON)
        set(_need_dx12 ON)
    endif()
    find_package(Vulkan QUIET)
    if(Vulkan_FOUND)
        set(_need_vulkan ON)
    else()
        message(STATUS "ImForge: Vulkan SDK not found, vulkan examples will be skipped")
    endif()
endif()

# SDL3 only if something needs it and this imgui version has the SDL3 backend
if(_need_sdl3)
    if(EXISTS "${imgui_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp")
        set(SDL_SHARED OFF CACHE BOOL "" FORCE)
        set(SDL_STATIC ON CACHE BOOL "" FORCE)
        set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
        set(SDL_TESTS OFF CACHE BOOL "" FORCE)
        set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
        set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
        set(SDL_INSTALL_DOCS OFF CACHE BOOL "" FORCE)
        set(SDL_UNINSTALL OFF CACHE BOOL "" FORCE)
        if(UNIX AND NOT APPLE)
            find_library(IMFORGE_X11_LIBRARY X11)
            find_library(IMFORGE_WAYLAND_LIBRARY wayland-client)
            if(NOT IMFORGE_X11_LIBRARY AND NOT IMFORGE_WAYLAND_LIBRARY)
                message(WARNING "ImForge: no X11 or Wayland development libraries found; SDL3 is built as a console-only library (SDL_UNIX_CONSOLE_BUILD=ON) and the builder will not be able to open a window on this machine. Install libx11-dev/libwayland-dev (see docs/USER_GUIDE.md) for a usable editor.")
                set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
            endif()
        endif()
        FetchContent_Declare(SDL3
            GIT_REPOSITORY https://github.com/libsdl-org/SDL.git
            GIT_TAG        release-3.2.30
            GIT_SHALLOW    TRUE
            GIT_PROGRESS   TRUE)
        FetchContent_MakeAvailable(SDL3)
        imforge_add_imgui_backend(sdl3 SDL3::SDL3)
    else()
        message(WARNING "ImForge: Dear ImGui '${IMFORGE_IMGUI_TAG}' has no SDL3 backend; SDL3-based targets will be skipped")
    endif()
endif()

if(_need_gl3)
    if(WIN32)
        set(_gl_libs opengl32)
    elseif(APPLE)
        set(_gl_libs "-framework OpenGL")
    else()
        set(_gl_libs ${CMAKE_DL_LIBS})
    endif()
    imforge_add_imgui_backend(opengl3 ${_gl_libs})
endif()
if(_need_win32 AND WIN32)
    imforge_add_imgui_backend(win32 dwmapi imm32)
endif()
if(_need_dx9 AND WIN32)
    imforge_add_imgui_backend(dx9 d3d9)
endif()
if(_need_dx11 AND WIN32)
    imforge_add_imgui_backend(dx11 d3d11 dxgi d3dcompiler)
endif()
if(_need_dx12 AND WIN32)
    imforge_add_imgui_backend(dx12 d3d12 dxgi d3dcompiler)
endif()
if(_need_vulkan)
    imforge_add_imgui_backend(vulkan Vulkan::Vulkan)
endif()

# doctest is header only, skip its CMake project
if(IMFORGE_BUILD_TESTS)
    FetchContent_Declare(doctest
        GIT_REPOSITORY https://github.com/doctest/doctest.git
        GIT_TAG        v2.4.11
        GIT_SHALLOW    TRUE
        GIT_PROGRESS   TRUE
        SOURCE_SUBDIR  imforge_no_cmake_project)
    FetchContent_MakeAvailable(doctest)
    add_library(doctest INTERFACE)
    add_library(doctest::doctest ALIAS doctest)
    target_include_directories(doctest INTERFACE "${doctest_SOURCE_DIR}" "${doctest_SOURCE_DIR}/doctest")
endif()

