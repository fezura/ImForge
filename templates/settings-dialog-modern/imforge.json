{
  "activeTheme": "SoftDesktop",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [
      "AppSettings"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "app",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": false,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Title",
      "ranges": "default",
      "size": 24
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Settings.imb.json"
  ],
  "platform": {
    "renderer": "gl3",
    "window": "glfw"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Button": "#2b71e2ff",
        "ButtonActive": "#225ab5ff",
        "ButtonHovered": "#2766cbff",
        "Text": "#ffffffff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#d4d4daff",
        "ChildBg": "#ffffffff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 10,
        "WindowPadding": {
          "x": 14,
          "y": 12
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#d93d438c",
        "Button": "#d93d4329",
        "ButtonActive": "#d93d435c",
        "ButtonHovered": "#d93d4342",
        "CheckMark": "#d93d43ff",
        "SliderGrab": "#d93d43ff",
        "SliderGrabActive": "#d93d43ff",
        "Text": "#87262aff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#2f7bf673",
        "Button": "#00000000",
        "ButtonActive": "#2f7bf63d",
        "ButtonHovered": "#2f7bf624",
        "Text": "#2054a7ff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Text": "#111114ff"
      }
    },
    "muted": {
      "colors": {
        "Text": "#676771ff"
      }
    },
    "sidebar": {
      "colors": {
        "Border": "#d4d4daff",
        "ChildBg": "#e4e4e8ff"
      },
      "vars": {
        "ChildRounding": 8,
        "WindowPadding": {
          "x": 10,
          "y": 12
        }
      }
    },
    "success": {
      "colors": {
        "Border": "#1f9a4b8c",
        "Button": "#1f9a4b29",
        "ButtonActive": "#1f9a4b5c",
        "ButtonHovered": "#1f9a4b42",
        "CheckMark": "#1f9a4bff",
        "SliderGrab": "#1f9a4bff",
        "SliderGrabActive": "#1f9a4bff",
        "Text": "#135c2dff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#b8740a8c",
        "Button": "#b8740a29",
        "ButtonActive": "#b8740a5c",
        "ButtonHovered": "#b8740a42",
        "CheckMark": "#b8740aff",
        "SliderGrab": "#b8740aff",
        "SliderGrabActive": "#b8740aff",
        "Text": "#6e4606ff"
      }
    }
  },
  "themes": [
    "themes/SoftDesktop.theme.json"
  ]
}
