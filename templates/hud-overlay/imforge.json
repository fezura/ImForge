{
  "activeTheme": "MilitaryOliveHUD",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [],
    "typesJson": ""
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "hud",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Display",
      "ranges": "default",
      "size": 34
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Hud.imb.json"
  ],
  "platform": {
    "renderer": "dx11",
    "window": "win32"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Border": "#b5c36acc",
        "Button": "#b5c36aff",
        "ButtonActive": "#e0a93bff",
        "ButtonHovered": "#c6d27eff",
        "Text": "#0f120cff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#3a4329ff",
        "ChildBg": "#141710ff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 0,
        "WindowPadding": {
          "x": 8,
          "y": 6
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#d9534f8c",
        "Button": "#d9534f29",
        "ButtonActive": "#d9534f6b",
        "ButtonHovered": "#d9534f47",
        "CheckMark": "#d9534fff",
        "SliderGrab": "#d9534fff",
        "SliderGrabActive": "#d9534fff",
        "Text": "#db7b72ff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#e0a93b80",
        "Button": "#e0a93b00",
        "ButtonActive": "#e0a93b42",
        "ButtonHovered": "#e0a93b24",
        "Text": "#e0a93bff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Separator": "#e0a93b99",
        "Text": "#e0a93bff"
      },
      "vars": {
        "SeparatorTextBorderSize": 1
      }
    },
    "hud_big": {
      "colors": {
        "Text": "#eef2dcff"
      }
    },
    "hud_dim": {
      "colors": {
        "Text": "#a9b294cc"
      }
    },
    "muted": {
      "colors": {
        "Text": "#8b9478ff"
      }
    },
    "success": {
      "colors": {
        "Border": "#8fd14f8c",
        "Button": "#8fd14f29",
        "ButtonActive": "#8fd14f6b",
        "ButtonHovered": "#8fd14f47",
        "CheckMark": "#8fd14fff",
        "SliderGrab": "#8fd14fff",
        "SliderGrabActive": "#8fd14fff",
        "Text": "#8fd14fff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#e0a93b8c",
        "Button": "#e0a93b29",
        "ButtonActive": "#e0a93b6b",
        "ButtonHovered": "#e0a93b47",
        "CheckMark": "#e0a93bff",
        "SliderGrab": "#e0a93bff",
        "SliderGrabActive": "#e0a93bff",
        "Text": "#e0a93bff"
      }
    }
  },
  "themes": [
    "themes/MilitaryOliveHUD.theme.json"
  ]
}
