{
  "activeTheme": "MidnightTool",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [
      "SceneObject"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "tools",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": true,
    "dpiScaling": true,
    "drawlistFx": false,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 15
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "docking",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Inspector.imb.json"
  ],
  "platform": {
    "renderer": "gl3",
    "window": "sdl3"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Button": "#4d8dffff",
        "ButtonActive": "#4279dbff",
        "ButtonHovered": "#669dffff",
        "Text": "#0c0d11ff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#2e3443ff",
        "ChildBg": "#1a1d25ff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 4,
        "WindowPadding": {
          "x": 10,
          "y": 8
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#e85a508c",
        "Button": "#e85a5029",
        "ButtonActive": "#e85a505c",
        "ButtonHovered": "#e85a5042",
        "CheckMark": "#e85a50ff",
        "SliderGrab": "#e85a50ff",
        "SliderGrabActive": "#e85a50ff",
        "Text": "#ef8f88ff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#4d8dff80",
        "Button": "#00000000",
        "ButtonActive": "#4d8dff3d",
        "ButtonHovered": "#4d8dff24",
        "Text": "#629bffff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "heading": {
      "colors": {
        "Text": "#eff1f6ff"
      }
    },
    "muted": {
      "colors": {
        "Text": "#8790a3ff"
      }
    },
    "success": {
      "colors": {
        "Border": "#4cc38a8c",
        "Button": "#4cc38a29",
        "ButtonActive": "#4cc38a5c",
        "ButtonHovered": "#4cc38a42",
        "CheckMark": "#4cc38aff",
        "SliderGrab": "#4cc38aff",
        "SliderGrabActive": "#4cc38aff",
        "Text": "#73d0a4ff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#e5b4548c",
        "Button": "#e5b45429",
        "ButtonActive": "#e5b4545c",
        "ButtonHovered": "#e5b45442",
        "CheckMark": "#e5b454ff",
        "SliderGrab": "#e5b454ff",
        "SliderGrabActive": "#e5b454ff",
        "Text": "#e9c06fff"
      }
    }
  },
  "themes": [
    "themes/MidnightTool.theme.json"
  ]
}
