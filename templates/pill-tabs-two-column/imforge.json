{
  "activeTheme": "EsportsRed",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [
      "Config"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "menu",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Title",
      "ranges": "default",
      "size": 24
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Menu.imb.json"
  ],
  "platform": {
    "renderer": "dx11",
    "window": "win32"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Border": "#d81c2acc",
        "Button": "#d81c2aff",
        "ButtonActive": "#a8121eff",
        "ButtonHovered": "#e0202eff",
        "Text": "#ffffffff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#2c2c33ff",
        "ChildBg": "#151518ff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 0,
        "WindowPadding": {
          "x": 10,
          "y": 8
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#ff54708c",
        "Button": "#ff547029",
        "ButtonActive": "#ff54706b",
        "ButtonHovered": "#ff547047",
        "CheckMark": "#ff5470ff",
        "SliderGrab": "#ff5470ff",
        "SliderGrabActive": "#ff5470ff",
        "Text": "#fe607aff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#ff6b3d80",
        "Button": "#ff6b3d00",
        "ButtonActive": "#ff6b3d42",
        "ButtonHovered": "#ff6b3d24",
        "Text": "#ff6b3dff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Separator": "#e8202fff",
        "Text": "#ffffffff"
      },
      "vars": {
        "SeparatorTextBorderSize": 3
      }
    },
    "muted": {
      "colors": {
        "Text": "#8a8a96ff"
      }
    },
    "success": {
      "colors": {
        "Border": "#2ecc718c",
        "Button": "#2ecc7129",
        "ButtonActive": "#2ecc716b",
        "ButtonHovered": "#2ecc7147",
        "CheckMark": "#2ecc71ff",
        "SliderGrab": "#2ecc71ff",
        "SliderGrabActive": "#2ecc71ff",
        "Text": "#2ecc71ff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#f5b7008c",
        "Button": "#f5b70029",
        "ButtonActive": "#f5b7006b",
        "ButtonHovered": "#f5b70047",
        "CheckMark": "#f5b700ff",
        "SliderGrab": "#f5b700ff",
        "SliderGrabActive": "#f5b700ff",
        "Text": "#f5b700ff"
      }
    }
  },
  "themes": [
    "themes/EsportsRed.theme.json"
  ]
}
