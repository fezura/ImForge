{
  "activeTheme": "Graphite",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [
      "Object"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "tools",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": true,
    "dpiScaling": true,
    "drawlistFx": false,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    }
  ],
  "imgui": {
    "branch": "docking",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Inspector.imb.json"
  ],
  "platform": {
    "renderer": "gl3",
    "window": "sdl3"
  },
  "schemaVersion": 1,
  "styleClasses": {},
  "themes": [
    "themes/Graphite.theme.json"
  ]
}
