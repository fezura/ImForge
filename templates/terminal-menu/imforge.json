{
  "activeTheme": "RetroTerminal",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [],
    "typesJson": ""
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "console",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/JetBrainsMono-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 15
    },
    {
      "file": "fonts/JetBrainsMono-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 15
    },
    {
      "file": "fonts/JetBrainsMono-Regular.ttf",
      "mergeIcons": "none",
      "name": "MonoBig",
      "ranges": "default",
      "size": 20
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Console.imb.json"
  ],
  "platform": {
    "renderer": "dx11",
    "window": "win32"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Border": "#33ff66cc",
        "Button": "#33ff66ff",
        "ButtonActive": "#b8ff3dff",
        "ButtonHovered": "#7dff9aff",
        "Text": "#050a05ff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#1d4d26ff",
        "ChildBg": "#081108ff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 0,
        "WindowPadding": {
          "x": 8,
          "y": 6
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#ff5c4d8c",
        "Button": "#ff5c4d29",
        "ButtonActive": "#ff5c4d6b",
        "ButtonHovered": "#ff5c4d47",
        "CheckMark": "#ff5c4dff",
        "SliderGrab": "#ff5c4dff",
        "SliderGrabActive": "#ff5c4dff",
        "Text": "#ff5c4dff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#33ff6680",
        "Button": "#33ff6600",
        "ButtonActive": "#33ff6642",
        "ButtonHovered": "#33ff6624",
        "Text": "#33ff66ff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Separator": "#33ff6680",
        "Text": "#b8ff3dff"
      },
      "vars": {
        "SeparatorTextBorderSize": 1
      }
    },
    "muted": {
      "colors": {
        "Text": "#3f8f4fff"
      }
    },
    "success": {
      "colors": {
        "Border": "#33ff668c",
        "Button": "#33ff6629",
        "ButtonActive": "#33ff666b",
        "ButtonHovered": "#33ff6647",
        "CheckMark": "#33ff66ff",
        "SliderGrab": "#33ff66ff",
        "SliderGrabActive": "#33ff66ff",
        "Text": "#33ff66ff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#e6ff4d8c",
        "Button": "#e6ff4d29",
        "ButtonActive": "#e6ff4d6b",
        "ButtonHovered": "#e6ff4d47",
        "CheckMark": "#e6ff4dff",
        "SliderGrab": "#e6ff4dff",
        "SliderGrabActive": "#e6ff4dff",
        "Text": "#e6ff4dff"
      }
    }
  },
  "themes": [
    "themes/RetroTerminal.theme.json"
  ]
}
