{
  "activeTheme": "GlassDark",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [],
    "typesJson": ""
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "quick",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": true
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Title",
      "ranges": "default",
      "size": 24
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/QuickMenu.imb.json"
  ],
  "platform": {
    "renderer": "dx11",
    "window": "win32"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Border": "#7aa8ffcc",
        "Button": "#7aa8ffff",
        "ButtonActive": "#b693ffff",
        "ButtonHovered": "#94baffff",
        "Text": "#0b0e17ff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#ffffff26",
        "ChildBg": "#ffffff0f"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 12,
        "WindowPadding": {
          "x": 14,
          "y": 12
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#ff6b8a8c",
        "Button": "#ff6b8a29",
        "ButtonActive": "#ff6b8a6b",
        "ButtonHovered": "#ff6b8a47",
        "CheckMark": "#ff6b8aff",
        "SliderGrab": "#ff6b8aff",
        "SliderGrabActive": "#ff6b8aff",
        "Text": "#f8b3c7ff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#ffffff80",
        "Button": "#ffffff00",
        "ButtonActive": "#ffffff2e",
        "ButtonHovered": "#ffffff1a",
        "Text": "#f2f5ffff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Separator": "#ffffff40",
        "Text": "#ffffffff"
      },
      "vars": {
        "SeparatorTextBorderSize": 1
      }
    },
    "hub": {
      "colors": {
        "Border": "#7aa8ff66",
        "Button": "#0b0e17cc",
        "ButtonActive": "#1d2540cc",
        "ButtonHovered": "#141a2ccc"
      },
      "vars": {
        "FrameBorderSize": 2,
        "FrameRounding": 52
      }
    },
    "muted": {
      "colors": {
        "Text": "#abb2cdff"
      }
    },
    "success": {
      "colors": {
        "Border": "#5fe0a88c",
        "Button": "#5fe0a829",
        "ButtonActive": "#5fe0a86b",
        "ButtonHovered": "#5fe0a847",
        "CheckMark": "#5fe0a8ff",
        "SliderGrab": "#5fe0a8ff",
        "SliderGrabActive": "#5fe0a8ff",
        "Text": "#a1e9cfff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#ffd36b8c",
        "Button": "#ffd36b29",
        "ButtonActive": "#ffd36b6b",
        "ButtonHovered": "#ffd36b47",
        "CheckMark": "#ffd36bff",
        "SliderGrab": "#ffd36bff",
        "SliderGrabActive": "#ffd36bff",
        "Text": "#fae0a2ff"
      }
    },
    "wedge": {
      "colors": {
        "Border": "#ffffff2e",
        "Button": "#ffffff14",
        "ButtonActive": "#7aa8ff99",
        "ButtonHovered": "#7aa8ff59"
      },
      "vars": {
        "FrameBorderSize": 1,
        "FrameRounding": 30
      }
    }
  },
  "themes": [
    "themes/GlassDark.theme.json"
  ]
}
