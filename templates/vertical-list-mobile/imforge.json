{
  "activeTheme": "PastelCute",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [],
    "typesJson": ""
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "mobile",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Title",
      "ranges": "default",
      "size": 24
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Settings.imb.json"
  ],
  "platform": {
    "renderer": "gl3",
    "window": "sdl3"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Button": "#ff8fbfff",
        "ButtonActive": "#f77fb2ff",
        "ButtonHovered": "#ffa5ccff",
        "Text": "#3a2b42ff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#f3d3e2ff",
        "ChildBg": "#ffffffff"
      },
      "vars": {
        "ChildBorderSize": 1.5,
        "ChildRounding": 18,
        "WindowPadding": {
          "x": 18,
          "y": 16
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#f2668b8c",
        "Button": "#f2668b29",
        "ButtonActive": "#f2668b5c",
        "ButtonHovered": "#f2668b42",
        "CheckMark": "#f2668bff",
        "SliderGrab": "#f2668bff",
        "SliderGrabActive": "#f2668bff",
        "Text": "#913d53ff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#ff8fbf99",
        "Button": "#00000000",
        "ButtonActive": "#ff8fbf3d",
        "ButtonHovered": "#ff8fbf24",
        "Text": "#8f506bff"
      },
      "vars": {
        "FrameBorderSize": 1.5
      }
    },
    "heading": {
      "colors": {
        "Separator": "#9fd8ffff",
        "Text": "#c04378ff"
      }
    },
    "muted": {
      "colors": {
        "Text": "#7a6884ff"
      }
    },
    "success": {
      "colors": {
        "Border": "#6fcf978c",
        "Button": "#6fcf9729",
        "ButtonActive": "#6fcf975c",
        "ButtonHovered": "#6fcf9742",
        "CheckMark": "#6fcf97ff",
        "SliderGrab": "#6fcf97ff",
        "SliderGrabActive": "#6fcf97ff",
        "Text": "#3a6c4fff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#f2b84b8c",
        "Button": "#f2b84b29",
        "ButtonActive": "#f2b84b5c",
        "ButtonHovered": "#f2b84b42",
        "CheckMark": "#f2b84bff",
        "SliderGrab": "#f2b84bff",
        "SliderGrabActive": "#f2b84bff",
        "Text": "#795c25ff"
      }
    }
  },
  "themes": [
    "themes/PastelCute.theme.json"
  ]
}
