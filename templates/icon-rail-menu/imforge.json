{
  "activeTheme": "SleekPurpleGamer",
  "binding": {
    "compileCommands": "",
    "includePaths": [],
    "types": [
      "Settings"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 16,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "menu",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": false,
    "dpiScaling": true,
    "drawlistFx": true,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 16
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Title",
      "ranges": "default",
      "size": 24
    },
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Small",
      "ranges": "default",
      "size": 13
    }
  ],
  "imgui": {
    "branch": "master",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ImForge",
    "shmName": "ImForge",
    "tcpPort": 7777,
    "transport": "tcp"
  },
  "name": "{{PROJECT_NAME}}",
  "panels": [
    "panels/Menu.imb.json"
  ],
  "platform": {
    "renderer": "dx11",
    "window": "win32"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "accent_button": {
      "colors": {
        "Border": "#7c4ff0cc",
        "Button": "#7c4ff0ff",
        "ButtonActive": "#6a3fd8ff",
        "ButtonHovered": "#8255f2ff",
        "Text": "#ffffffff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#2b2440ff",
        "ChildBg": "#15111fff"
      },
      "vars": {
        "ChildBorderSize": 0,
        "ChildRounding": 10,
        "WindowPadding": {
          "x": 14,
          "y": 12
        }
      }
    },
    "danger": {
      "colors": {
        "Border": "#f2445f8c",
        "Button": "#f2445f29",
        "ButtonActive": "#f2445f6b",
        "ButtonHovered": "#f2445f47",
        "CheckMark": "#f2445fff",
        "SliderGrab": "#f2445fff",
        "SliderGrabActive": "#f2445fff",
        "Text": "#f1657eff"
      }
    },
    "ghost_button": {
      "colors": {
        "Border": "#c38bff80",
        "Button": "#c38bff00",
        "ButtonActive": "#c38bff42",
        "ButtonHovered": "#c38bff24",
        "Text": "#c38bffff"
      },
      "vars": {
        "FrameBorderSize": 1
      }
    },
    "heading": {
      "colors": {
        "Separator": "#8a5cf599",
        "Text": "#c38bffff"
      },
      "vars": {
        "SeparatorTextBorderSize": 2
      }
    },
    "muted": {
      "colors": {
        "Text": "#8c84a8ff"
      }
    },
    "rail": {
      "colors": {
        "Border": "#2b244000",
        "ChildBg": "#0b0912ff"
      },
      "vars": {
        "ChildRounding": 0
      }
    },
    "success": {
      "colors": {
        "Border": "#3ad29f8c",
        "Button": "#3ad29f29",
        "ButtonActive": "#3ad29f6b",
        "ButtonHovered": "#3ad29f47",
        "CheckMark": "#3ad29fff",
        "SliderGrab": "#3ad29fff",
        "SliderGrabActive": "#3ad29fff",
        "Text": "#3ad29fff"
      }
    },
    "warning": {
      "colors": {
        "Border": "#f7bd2b8c",
        "Button": "#f7bd2b29",
        "ButtonActive": "#f7bd2b6b",
        "ButtonHovered": "#f7bd2b47",
        "CheckMark": "#f7bd2bff",
        "SliderGrab": "#f7bd2bff",
        "SliderGrabActive": "#f7bd2bff",
        "Text": "#f7bd2bff"
      }
    }
  },
  "themes": [
    "themes/SleekPurpleGamer.theme.json"
  ]
}
