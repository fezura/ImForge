{
  "credit": "Solarized palette (MIT)",
  "description": "Ethan Schoonover's Solarized on its dark base, with framed inputs and a compact layout. No glow, no blur, just balanced contrast.",
  "fonts": [
    {
      "family": "Source Sans 3",
      "role": "ui",
      "size": 16
    },
    {
      "family": "Source Sans 3",
      "role": "heading",
      "size": 19,
      "weight": "SemiBold"
    },
    {
      "family": "Fira Code",
      "role": "mono",
      "size": 14
    }
  ],
  "fx": {
    "accentGlow": 0,
    "windowBlur": 0,
    "windowShadow": 0
  },
  "kind": "design",
  "motions": {
    "button.hover": "PressReady",
    "button.press": "Shrink",
    "list": {
      "preset": "StaggerFadeIn",
      "stagger": 0.03
    },
    "window": "FadeIn",
    "window.exit": "FadeOut"
  },
  "name": "SolarizedDark",
  "schemaVersion": 1,
  "styleClasses": {
