{
  "credit": "One Dark palette (MIT)",
  "description": "The One Dark editor palette: neutral gray blue, soft white text and the familiar syntax colors as accents. Inputs are sunken and tabs work like editor tabs.",
  "fonts": [
    {
      "family": "Inter",
      "role": "ui",
      "size": 14
    },
    {
      "family": "Inter",
      "role": "heading",
      "size": 17,
      "weight": "Bold"
    },
    {
      "family": "JetBrains Mono",
      "role": "mono",
      "size": 14
    }
  ],
  "fx": {
    "accentGlow": 0,
    "windowBlur": 0,
    "windowShadow": 0.15
  },
  "kind": "design",
  "motions": {
    "button.hover": "Brighten",
    "button.press": "PushIn",
    "list": {
      "preset": "StaggerFadeDown",
      "stagger": 0.03
    },
    "window": "FadeIn",
    "window.exit": "FadeOut"
  },
  "name": "OneDark",
  "schemaVersion": 1,
  "styleClasses": {
    "accent-button": {
      "colors": {
        "Button": "#61afefff",
        "ButtonActive": "#56b6c2ff",
        "ButtonHovered": "#74b9f1ff",
        "Text": "#282c34ff"
      },
      "vars": {
        "FrameBorderSize": 0
      }
    },
    "card": {
      "colors": {
        "Border": "#3b4048ff",
        "ChildBg": "#2c323cff"
      },
      "vars": {
        "ChildBorderSize": 1,
        "ChildRounding": 4,
        "WindowPadding": {
          "x": 10,
          "y": 8
        }
      }
    },
