{
  "credit": "Kanagawa palette (MIT)",
  "description": "Kanagawa Wave: indigo ink, parchment text and muted woodblock print colors. A mincho heading font and wipe in motion give it a printed feel.",
  "fonts": [
    {
      "family": "Zen Kaku Gothic New",
      "role": "ui",
      "size": 15
    },
    {
      "family": "Shippori Mincho",
      "role": "heading",
      "size": 20,
      "weight": "Bold"
    }
