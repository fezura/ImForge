  "fx": {
    "accentGlow": 0,
    "windowBlur": 0,
    "windowShadow": 0.2
  },
  "kind": "design",
  "motions": {
    "button.hover": "NudgeRight",
    "button.press": "Sink",
    "list": {
      "preset": "StaggerReveal",
      "stagger": 0.05
    },
    "window": "ClipRevealRight",
    "window.exit": "ClipHideRight"
  },
  "name": "KanagawaWave",
