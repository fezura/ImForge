{
  "credit": "Nord palette (MIT)",
  "description": "Nord's arctic blues on slate gray, with frost colored accents and framed inputs. Low contrast surfaces that stay easy on the eyes for long sessions.",
  "fonts": [
    {
      "family": "Inter",
      "role": "ui",
      "size": 15
    },
    {
      "family": "Inter",
      "role": "heading",
      "size": 18,
      "weight": "SemiBold"
    },
    {
