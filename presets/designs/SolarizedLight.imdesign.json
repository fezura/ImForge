{
  "credit": "Solarized palette (MIT)",
  "description": "Solarized on its light paper base, with blue accents and framed inputs. Body text sits a shade darker than stock Solarized so small labels stay readable.",
  "fonts": [
    {
      "family": "Source Sans 3",
      "role": "ui",
      "size": 16
    },
    {
      "family": "Source Sans 3",
      "role": "heading",
      "size": 19,
      "weight": "SemiBold"
    },
    {
      "family": "Fira Code",
      "role": "mono",
      "size": 14
    }
  ],
  "fx": {
    "accentGlow": 0,
    "windowBlur": 0,
    "windowShadow": 0.1
  },
  "kind": "design",
  "motions": {
    "button.hover": "PressReady",
    "button.press": "Shrink",
    "list": {
      "preset": "StaggerFadeIn",
      "stagger": 0.03
    },
    "window": "FadeIn",
    "window.exit": "FadeOut"
  },
  "name": "SolarizedLight",
  "schemaVersion": 1,
