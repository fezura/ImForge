{
  "credit": "",
  "description": "A neutral dark theme for editors and inspectors, with one calm blue accent and teal for secondary data. Dense spacing, filled frames and very little decoration.",
  "fonts": [
    {
      "family": "Inter",
      "role": "ui",
      "size": 14
    },
    {
      "family": "Inter",
      "role": "heading",
      "size": 16,
      "weight": "SemiBold"
    },
    {
      "family": "JetBrains Mono",
      "role": "mono",
      "size": 13
    }
  ],
  "fx": {
    "accentGlow": 0,
    "windowBlur": 0,
    "windowShadow": 0.15
  },
  "kind": "design",
  "motions": {
    "button.hover": "Brighten",
    "button.press": "PressDown",
    "list": {
      "preset": "StaggerReveal",
      "stagger": 0.03
    },
    "window": "FadeIn",
    "window.exit": "FadeOut"
  },
  "name": "MidnightTool",
