{
  "activeTheme": "Graphite",
  "binding": {
    "compileCommands": "build/compile_commands.json",
    "includePaths": [
      "src",
      "third_party"
    ],
    "types": [
      "Transform",
      "Material",
      "Stats",
      "LogBuffer"
    ],
    "typesJson": "types.json"
  },
  "codegen": {
    "baseFontSize": 15,
    "cppStandard": 17,
    "dpiMode": "fontSize",
    "functionCase": "pascal",
    "indent": 4,
    "markers": true,
    "namespace": "tools",
    "outputDir": "generated",
    "runtimeHeader": "imb_runtime.h",
    "splitHeader": true,
    "stdString": true,
    "useTabs": false,
    "variableCase": "snake"
  },
  "components": [],
  "features": {
    "animations": true,
    "docking": true,
    "dpiScaling": true,
    "drawlistFx": false,
    "iconFonts": true,
    "shaderFx": false
  },
  "fonts": [
    {
      "file": "fonts/Inter-Regular.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Default",
      "ranges": "default",
      "size": 15
    },
    {
      "file": "fonts/Inter-Bold.ttf",
      "mergeIcons": "fontawesome6",
      "name": "Bold",
      "ranges": "default",
      "size": 15
    },
    {
      "file": "fonts/JetBrainsMono-Regular.ttf",
      "mergeIcons": "none",
      "name": "Mono",
      "ranges": "default",
      "size": 14
    }
  ],
  "imgui": {
    "branch": "docking",
    "version": "1.91.9"
  },
  "kind": "project",
  "libraries": [],
  "live": {
    "enabled": true,
    "pipeName": "ToolDock",
    "shmName": "ToolDock",
    "tcpPort": 7777,
    "transport": "pipe"
  },
  "name": "ToolDock",
  "panels": [
    "panels/Inspector.imb.json",
    "panels/LogView.imb.json"
  ],
  "platform": {
    "renderer": "gl3",
    "window": "sdl3"
  },
  "schemaVersion": 1,
  "styleClasses": {
    "label": {
      "colors": {
        "Text": "#a0a0a0ff"
      }
    },
    "warning": {
      "colors": {
        "Text": "#f0883eff"
      }
    }
  },
  "themes": [
    "themes/Graphite.theme.json"
  ]
}
