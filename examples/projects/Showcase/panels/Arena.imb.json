                            "type": "KillFeedEntry",
                            "visibleIf": "state.showSecondKill"
                          }
                        ],
                        "id": "vitals_col",
                        "props": {
                          "spacing": 6
                        },
                        "type": "VStack"
                      }
                    ],
                    "id": "previews",
                    "props": {
                      "columns": 4,
                      "flags": [
                        "SizingStretchSame"
                      ]
                    },
                    "type": "Grid"
                  },
                  {
                    "children": [
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "FadeInLeftBig"
                            }
                          ]
