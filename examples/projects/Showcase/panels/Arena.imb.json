{
  "kind": "panel",
  "name": "Arena",
  "params": [
    {
      "name": "arena",
      "type": "ArenaConfig"
    }
  ],
  "root": {
    "anim": {
      "motions": [
        {
          "preset": "BlurIn"
        },
        {
          "preset": "PopOut",
          "trigger": "exit"
        }
      ]
    },
    "bind": {
      "open": "state.open"
    },
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "anim": {
                      "motions": [
                        {
                          "preset": "SpinSlow",
                          "trigger": "loop"
                        }
                      ]
                    },
                    "font": "Title",
                    "id": "rail_logo",
                    "props": {
                      "color": "#7fd7ffff",
                      "text": " {icon:fa-snowflake}"
                    },
                    "type": "Text"
                  },
                  {
                    "anim": {
                      "motions": [
                        {
                          "preset": "SlideInLeft"
                        }
                      ]
                    },
                    "bind": {
                      "index": "state.page"
                    },
                    "id": "rail_nav",
                    "props": {
                      "icons": [
                        "fa-crosshairs",
                        "fa-eye",
                        "fa-users",
                        "fa-gear"
                      ],
                      "label": "##rail",
                      "tooltips": [
                        "Combat",
                        "Visuals",
                        "Players",
                        "Config"
                      ]
                    },
                    "type": "IconRailNav"
                  }
                ],
                "id": "rail_stack",
                "props": {
                  "spacing": 10
                },
                "type": "VStack"
              }
            ],
            "id": "rail",
