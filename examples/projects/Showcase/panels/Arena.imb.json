                            {
                              "preset": "Raise",
                              "trigger": "hover"
                            },
                            {
                              "on": "onChange",
                              "preset": "HeadShake",
                              "trigger": "attention"
                            }
                          ]
                        },
                        "bind": {
                          "enabled": "arena.aim"
                        },
                        "id": "cat_aim",
                        "props": {
                          "description": "Assist and trigger",
                          "icon": "fa-crosshairs",
                          "size": {
                            "h": "auto",
                            "w": "fill"
                          },
                          "title": "Aim"
                        },
                        "type": "CategoryCard"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "RollIn"
                            },
                            {
                              "preset": "Raise",
                              "trigger": "hover"
                            },
                            {
                              "on": "onChange",
                              "preset": "ShakeY",
                              "trigger": "attention"
                            }
                          ]
                        },
                        "bind": {
                          "enabled": "arena.esp"
                        },
                        "id": "cat_esp",
                        "props": {
                          "description": "Boxes and names",
                          "icon": "fa-eye",
                          "size": {
                            "h": "auto",
                            "w": "fill"
                          },
                          "title": "ESP"
                        },
                        "type": "CategoryCard"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "SwingIn"
                            },
                            {
                              "preset": "Raise",
                              "trigger": "hover"
                            },
                            {
                              "on": "onChange",
                              "preset": "Shimmy",
                              "trigger": "attention"
                            }
                          ]
                        },
                        "bind": {
                          "enabled": "arena.radar"
                        },
                        "id": "cat_radar",
                        "props": {
                          "description": "Everyone on the map",
                          "icon": "fa-satellite-dish",
                          "size": {
                            "h": "auto",
                            "w": "fill"
                          },
                          "title": "Radar"
                        },
                        "type": "CategoryCard"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "TiltIn"
                            },
                            {
                              "preset": "Raise",
                              "trigger": "hover"
                            },
                            {
                              "on": "onChange",
                              "preset": "Vibrate",
                              "trigger": "attention"
                            }
                          ]
                        },
                        "bind": {
                          "enabled": "arena.misc"
                        },
                        "id": "cat_misc",
                        "props": {
                          "description": "Movement helpers",
                          "icon": "fa-person-running",
                          "size": {
                            "h": "auto",
                            "w": "fill"
                          },
                          "title": "Misc"
                        },
                        "type": "CategoryCard"
                      }
                    ],
                    "id": "cats",
                    "props": {
                      "columns": 4,
                      "flags": [
                        "SizingStretchSame"
                      ]
