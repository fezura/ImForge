              "childFlags": [
                "AlwaysUseWindowPadding"
              ],
              "size": {
                "h": "fill",
                "w": 64
              }
            },
            "style": {
              "classes": [
                "card"
              ],
              "vars": {
                "WindowPadding": {
                  "x": 8,
                  "y": 12
                }
              }
            },
            "type": "Child"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "FadeInTopLeft"
                            }
                          ]
                        },
                        "id": "watermark",
                        "props": {
                          "extra": "IceFrost",
                          "text": "Arena"
                        },
                        "type": "Watermark"
                      },
                      {
                        "id": "top_fill",
                        "props": {
                          "size": {
                            "h": 1,
                            "w": "fill"
                          }
                        },
                        "type": "Dummy"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "FadeInTopRight"
                            }
                          ]
                        },
                        "id": "perf",
                        "props": {
                          "fps": "state.fps",
                          "label": "perf",
                          "ping": "state.ping"
                        },
                        "type": "FpsPingCounter"
                      }
                    ],
                    "id": "top",
                    "props": {
                      "spacing": 10
                    },
                    "type": "HStack"
                  },
                  {
                    "anim": {
                      "motions": [
                        {
                          "preset": "BackInDown"
                        },
                        {
                          "preset": "BackOutUp",
                          "trigger": "exit"
                        }
                      ]
                    },
                    "bind": {
                      "open": "state.bannerOpen"
                    },
                    "id": "banner",
                    "props": {
                      "action": "Undo",
                      "kind": "Success",
                      "label": "banner",
                      "text": "Config 'Ranked' loaded"
