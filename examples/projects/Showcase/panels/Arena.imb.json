                                "type": "PlayerListRow"
                              },
                              {
                                "id": "p2",
                                "props": {
                                  "health": "0.35",
                                  "label": "p2",
                                  "name": "Rook",
                                  "ping": "61",
                                  "team": "1"
                                },
                                "type": "PlayerListRow"
                              },
                              {
                                "id": "p3",
                                "props": {
                                  "health": "0.7",
                                  "label": "p3",
                                  "name": "Halo",
                                  "ping": "40",
                                  "selected": "true",
                                  "team": "1"
                                },
                                "type": "PlayerListRow"
                              }
