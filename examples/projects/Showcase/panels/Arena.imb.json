                            "type": "Text"
                          },
                          {
                            "anim": {
                              "motions": [
                                {
                                  "on": "onDelete",
                                  "preset": "ErrorShake",
                                  "trigger": "change"
                                }
                              ]
                            },
                            "bind": {
                              "selected": "arena.profile"
