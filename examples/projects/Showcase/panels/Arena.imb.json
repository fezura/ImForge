                            "id": "profiles",
                            "props": {
                              "label": "##profiles"
                            },
                            "type": "ProfileSlots"
                          }
                        ],
                        "id": "profiles_col",
                        "props": {
                          "spacing": 8
                        },
                        "type": "VStack"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "FadeInRightBig"
                            }
                          ]
                        },
                        "children": [
                          {
                            "font": "Bold",
                            "id": "hotkeys_title",
                            "props": {
                              "text": "Hotkeys"
                            },
                            "type": "Text"
                          },
                          {
                            "anim": {
                              "motions": [
                                {
                                  "on": "onChange",
                                  "preset": "Refresh",
                                  "trigger": "change"
                                }
                              ]
                            },
                            "id": "hotkeys",
                            "props": {
                              "label": "##hk"
                            },
                            "type": "HotkeyList"
                          },
                          {
                            "bind": {
                              "color": "arena.xhairColor",
                              "dot": "arena.dot",
                              "gap": "arena.gap",
                              "length": "arena.length",
                              "outline": "arena.outline",
                              "thickness": "arena.thickness"
                            },
                            "id": "xhair_editor",
                            "props": {
                              "label": "Crosshair"
                            },
                            "type": "CrosshairEditor"
                          }
                        ],
                        "id": "hotkeys_col",
                        "props": {
                          "spacing": 8
                        },
                        "type": "VStack"
                      }
                    ],
                    "id": "lower",
                    "props": {
                      "columns": 3,
                      "flags": [
                        "SizingStretchSame"
                      ]
                    },
                    "type": "Grid"
                  }
                ],
                "id": "main_stack",
                "props": {
                  "spacing": 12
                },
                "type": "VStack"
              }
            ],
            "id": "main",
            "props": {
              "childFlags": [
                "AlwaysUseWindowPadding"
              ],
              "size": {
                "h": "fill",
                "w": "fill"
              }
            },
            "style": {
              "colors": {
                "ChildBg": "#00000000"
              },
              "vars": {
                "WindowPadding": {
                  "x": 14,
                  "y": 10
                }
              }
            },
            "type": "Child"
          }
        ],
        "id": "shell",
        "props": {
          "spacing": 0
        },
        "type": "HStack"
      }
    ],
    "id": "window",
    "props": {
      "flags": [
        "NoCollapse"
      ],
      "initialSize": {
        "x": 1100,
        "y": 820
      },
      "sizeCond": "FirstUseEver",
      "title": "Arena  |  IceFrost"
    },
    "style": {
      "classes": [
        "design_icefrost"
      ],
      "vars": {
        "WindowPadding": {
          "x": 8,
          "y": 8
        }
      }
    },
    "type": "Window"
  },
  "schemaVersion": 1,
  "state": [
    {
      "default": true,
      "name": "open",
      "type": "bool"
    },
    {
      "default": 0,
      "name": "page",
      "type": "int"
    },
    {
      "default": 165,
      "name": "fps",
      "type": "float"
    },
    {
      "default": 19,
      "name": "ping",
      "type": "float"
    },
    {
      "default": true,
      "name": "bannerOpen",
      "type": "bool"
    },
    {
      "default": 64,
      "name": "health",
      "type": "float"
    },
    {
      "default": 80,
      "name": "armor",
      "type": "float"
    },
    {
      "default": true,
      "name": "showSecondKill",
      "type": "bool"
    }
  ]
}
