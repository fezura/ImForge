                            "id": "teams",
                            "props": {
                              "label": "Team colors"
                            },
                            "type": "TeamColorPicker"
                          }
                        ],
                        "id": "players_col",
                        "props": {
                          "spacing": 8
                        },
                        "type": "VStack"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "ZoomInRight"
                            }
                          ]
                        },
                        "children": [
                          {
                            "font": "Bold",
                            "id": "profiles_title",
                            "props": {
                              "text": "Profiles"
