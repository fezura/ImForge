                            "type": "CrosshairPreview"
                          },
                          {
                            "bind": {
                              "radius": "arena.fov"
                            },
                            "id": "fov",
                            "props": {
                              "label": "##fov",
                              "size": {
                                "h": 90,
                                "w": "fill"
                              }
                            },
                            "type": "FovCirclePreview"
                          }
                        ],
                        "id": "xhair_col",
                        "props": {
                          "spacing": 6
                        },
                        "type": "VStack"
                      },
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "GlowIn"
                            }
                          ]
                        },
                        "children": [
                          {
                            "font": "Bold",
                            "id": "radar_title",
                            "props": {
                              "text": "Radar"
                            },
                            "type": "Text"
                          },
                          {
                            "bind": {
                              "points": "arena.blips",
                              "rotation": "arena.yaw"
