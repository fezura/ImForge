                    "type": "Grid"
                  },
                  {
                    "children": [
                      {
                        "anim": {
                          "motions": [
                            {
                              "preset": "DropIn"
                            }
                          ]
                        },
                        "children": [
                          {
                            "font": "Bold",
                            "id": "esp_title",
                            "props": {
                              "text": "ESP preview"
                            },
                            "type": "Text"
                          },
                          {
                            "bind": {
                              "box": "arena.box",
                              "boxColor": "arena.enemyColor",
                              "boxStyle": "arena.boxStyle",
                              "health": "arena.health",
                              "healthBar": "arena.healthBar",
                              "name": "arena.names"
                            },
                            "id": "esp",
                            "props": {
                              "label": "##esp",
                              "size": {
                                "h": 190,
                                "w": "fill"
                              }
                            },
                            "type": "EspBoxPreview"
